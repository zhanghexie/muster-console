{
  "name": "muster-console",
  "version": "0.1.36",
  "description": "Muster Console · 集序：多多益善，集序有方。",
  "author": "Muster",
  "license": "MIT",
  "main": "out/main/index.js",
  "private": true,
  "packageManager": "traversal",
  "config": {
    "electron_mirror": "https://npmmirror.com/mirrors/electron/",
    "electron_builder_binaries_mirror": "https://npmmirror.com/mirrors/electron-builder-binaries/"
  },
  "scripts": {
    "postinstall": "node scripts/patch-pi-skill-discovery.mjs && node scripts/patch-pi-context-range.mjs",
    "desktop-driver:check": "node scripts/desktop-driver/build.mjs --check-host",
    "desktop-driver:sbom": "node scripts/desktop-driver/sbom.mjs --write .tmp/desktop-driver/sbom.cdx.json",
    "desktop-driver:sbom:check": "node scripts/desktop-driver/sbom.mjs --check .tmp/desktop-driver/sbom.cdx.json",
    "dev": "node scripts/dev.mjs",
    "dev:run": "node scripts/dev.mjs",
    "demo-build": "node scripts/demo.mjs --demo-build",
    "demo-run": "node scripts/demo.mjs --demo-run",
    "demo-delete": "node scripts/demo.mjs --demo-delete",
    "dev:no-sandbox": "node scripts/dev-no-sandbox.mjs",
    "capture:ui": "node scripts/capture-ui.mjs",
    "dev:clean": "node scripts/clean-dev-sandbox.mjs && node scripts/dev.mjs",
    "clean:sandbox": "node scripts/clean-dev-sandbox.mjs",
    "clean:tmp": "node scripts/clean-tmp.mjs",
    "save:sandbox": "node scripts/save-dev-sandbox.mjs",
    "reset:sandbox": "node scripts/reset-dev-sandbox.mjs",
    "test:ui": "node test/ui-sandbox.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:packaged-smoke": "node scripts/test-packaged-smoke.mjs",
    "verify:release-artifacts": "node scripts/verify-release-artifacts.mjs",
    "test:unit": "node scripts/test-unit.mjs",
    "test:coverage": "node scripts/test-unit.mjs --coverage --pool=threads && node scripts/coverage-report.mjs",
    "test:full": "node scripts/test-full.mjs",
    "test:integration": "node test/run.mjs --integration",
    "test:visual": "node test/run.mjs --visual",
    "test:audit": "node test/run.mjs --audit",
    "test:i18n:audit": "node test/i18n-coverage.mjs --audit",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node test/run.mjs",
    "test:changed": "node test/run.mjs --changed",
    "hooks:install": "node scripts/install-hooks.mjs",
    "hooks:uninstall": "node scripts/uninstall-hooks.mjs",
    "rebuild": "electron-rebuild -f -w node-pty",
    "mock-llm": "node test/mock-llm.mjs",
    "build:win": "electron-vite build && electron-builder --win --config",
    "release:win": "electron-vite build && electron-builder --win --config --publish always",
    "build:mac": "electron-vite build && electron-builder --mac --config -c.mac.identity=- -c.mac.hardenedRuntime=false -c.mac.notarize=false",
    "build:linux": "electron-vite build && electron-builder --linux --config"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.272",
    "@anthropic-ai/sdk": "^0.123.0",
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@larksuite/cli": "1.0.98",
    "@larksuiteoapi/node-sdk": "1.73.0",
    "@matrix-org/olm": "3.2.15",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@simple-git/argv-parser": "^3.0.0",
    "@tencent-connect/qqbot-nodejs": "1.0.4",
    "@vscode/ripgrep": "^1.18.0",
    "@wecom/aibot-node-sdk": "1.0.7",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "ajv": "^8.20.0",
    "border-beam": "^1.4.1",
    "commander": "^14.0.0",
    "dingtalk-stream": "2.1.4",
    "electron-updater": "~6.8.9",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "https-proxy-agent": "5.0.1",
    "i18next": "^26.4.0",
    "imapflow": "^2.9.1",
    "jsonc-parser": "^3.3.1",
    "koffi": "^3.3.5",
    "mailparser": "^3.12.3",
    "node-pty": "^1.1.0",
    "nodemailer": "^10.2.1",
    "pdfjs-dist": "^6.4.299",
    "picomatch": "^4.0.7",
    "playwright-core": "^1.63.0",
    "qrcode": "^1.5.4",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5",
    "simple-git": "^4.1.0",
    "smol-toml": "1.9.0",
    "undici": "7.30.2",
    "ws": "^8.21.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "^2.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@electron/rebuild": "^3.6.0",
    "@playwright/test": "^1.63.0",
    "@rrweb/record": "2.2.2",
    "@rrweb/replay": "2.2.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/mailparser": "^3.9.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/refractor": "^3.4.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^3.2.7",
    "@xterm/addon-fit": "^0.12.0-beta.298",
    "@xterm/addon-webgl": "^0.20.0-beta.297",
    "@xterm/xterm": "^6.1.0-beta.300",
    "d3": "7.9.0",
    "docx-preview": "^0.3.7",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "jsdom": "^30.0.1",
    "pele": "^1.9.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.28",
    "react": "^18.3.1",
    "react-diff-view": "^3.3.3",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.12",
    "react-markdown": "^10.1.0",
    "refractor": "^3.6.0",
    "remark-gfm": "^4.0.1",
    "three": "0.186.1",
    "typescript": "^5.5.4",
    "unidiff": "^1.0.4",
    "vite": "^5.3.5",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "undici": "8.12.4"
    }
  }
}
