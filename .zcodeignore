node_modules/
out/
dist/
release/
*.log
.tmp/

# Playwright E2E 产物（trace/失败截图/报告）
test-results/
playwright-report/

.superpowers/

.worktrees/

# ZCode 本地会话产物（计划文件等，不随仓库）
.zcode/


# Claude Code 本地个人设置（不入库）
.claude/settings.local.json

# 开发隔离沙箱（工作区、appData、测试仓库、快照模板，不入库）
.dev-sandbox/
.dev-sandbox-template/

# 第三方参考源码（本地只读对照，不入库）
refs/

# metaagent:begin (skill links)
.claude/skills
.cursor/skills
# metaagent:end (skill links)
.cursor/hooks.json
.metaAgent/workspace.json

# 自定义事件注册表（运行时审批态，本机数据不入库；scaffold 的 .metaAgent/.gitignore 契约不含它）
.metaAgent/events/

# 记忆派生态库（SQLite 派生索引，删库可从 markdown+转录重建，不入库）
.metaAgent/memory/
.codex/hooks.json

# Windows Git Bash 里 cmd 风格「> nul」重定向误生成的真实文件（bash 不把 nul 当设备名）
nul

# CodeGraph 索引（本地生成，勿提交）
.codegraph/

# run-dev 扩展的运行时锁（本机 PID/时间戳，不入库；代码对陈旧锁自愈）
.metaAgent/extensions/run-dev/data/

# 本地记忆 embedding 模型（构建期 scripts/fetch-memory-model.mjs 下载，模型文件绝不进 git）
build/memory-model/

