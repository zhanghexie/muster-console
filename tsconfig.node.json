{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // 死代码在这个仓库是零容忍项：让 npm run typecheck 直接挡住，别靠人眼 review
    "noUnusedLocals": true,
    "types": ["node"],
    "incremental": true,
    "tsBuildInfoFile": "./.tmp/tsbuildinfo/node.tsbuildinfo"
  },
  "include": ["src/main/**/*", "src/preload/**/*", "src/shared/**/*", "electron.vite.config.ts"]
}
