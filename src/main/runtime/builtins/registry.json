    {
      "id": "codebuddy-cli",
      "label": "CodeBuddy Code",
      "script": "",
      "builtin": true,
      "enabled": true,
      "surface": "pty",
      "extraArgs": [],
      "updatedAt": 0,
      "manifest": {
        "id": "codebuddy-cli",
        "label": "CodeBuddy Code",
        "installUrl": "https://www.codebuddy.cn/docs/cli/installation",
        "terminal": { "command": "codebuddy", "args": [] },
        "chat": {
          "transport": "acp",
          "command": "codebuddy",
          "args": ["--acp"],
          "mcpPermissionMetadata": {
            "toolNameKey": "codebuddy.ai/toolName",
            "requireApprovalKeys": ["codebuddy.ai/runtimeSecurity", "codebuddy.ai/sandboxIntercept", "codebuddy.ai/sensitiveProtectionApproval", "codebuddy.ai/approvalKind"]
          }
        },
        "capabilities": {
          "model": true,
          "permissions": [
            { "value": "default", "label": "默认审批", "args": ["--permission-mode", "default"] },
            { "value": "acceptEdits", "label": "自动批准编辑", "args": ["--permission-mode", "acceptEdits"] },
            { "value": "plan", "label": "计划模式", "args": ["--permission-mode", "plan"] },
            { "value": "dontAsk", "label": "不询问（拒绝需审批的操作）", "args": ["--permission-mode", "dontAsk"] },
            { "value": "auto", "label": "自动模式", "args": ["--permission-mode", "auto"] },
            { "value": "bypassPermissions", "label": "跳过权限检查", "args": ["--permission-mode", "bypassPermissions"] }
          ],
          "permissionFlags": { "--permission-mode": true, "--dangerously-skip-permissions": false, "-y": false },
          "reasoning": { "flag": "--effort", "levels": ["minimal", "low", "medium", "high", "xhigh", "max"] }
        },
        "integrations": {
          "skillDirectories": [
            { "id": "home-codebuddy-skills", "base": "home", "path": ".codebuddy/skills", "homeOverride": { "env": "CODEBUDDY_CONFIG_DIR", "path": "skills" }, "targets": ["codebuddy-cli"] },
            { "id": "workspace-codebuddy-skills", "base": "workspace", "path": ".codebuddy/skills", "targets": ["codebuddy-cli"] }
          ],
          "skillTargets": [
            { "id": "codebuddy-cli", "label": "CodeBuddy Code", "kind": "cli", "skillSupport": "native-directory", "directoryIds": ["home-codebuddy-skills", "workspace-codebuddy-skills"] }
          ],
          "mcp": {
            "strategy": "config-file",
            "format": "jsonc",
            "base": "home",
            "path": ".codebuddy/.mcp.json",
            "homeOverride": { "env": "CODEBUDDY_CONFIG_DIR", "path": ".mcp.json" },
            "fallbacks": [
              { "base": "home", "path": ".codebuddy/mcp.json", "homeOverride": { "env": "CODEBUDDY_CONFIG_DIR", "path": "mcp.json" } },
              { "base": "home", "path": ".codebuddy.json" }
            ]
          }
        }
      }
